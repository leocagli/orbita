# Cadena de conexión de Neon. La agrega `vercel integration add neon`.
DATABASE_URL=

# Clave HMAC del registro de consentimientos. Generar con: openssl rand -hex 32
REGISTRO_CLAVE=

# Vercel la manda en el header Authorization de los crons si está definida.
CRON_SECRET=

# Token para /v1/auditoria/verificar. Generar con: openssl rand -hex 32
ADMIN_TOKEN=

# JSON del service account de Firebase, en una sola línea. Si falta, los avisos
# solo se registran en la base y se leen por /v1/adultos/avisos.
FCM_SERVICE_ACCOUNT=
